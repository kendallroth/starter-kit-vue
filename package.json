{
  "name": "starter-kit-vue",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "api": "sk-api --port 3001",
    "build": "run-p type \"build:only {@}\" --",
    "build:only": "vite build",
    "code:format": "prettier --write \"**/*.{ts,vue}\" --ignore-path .gitignore",
    "code:lint": "eslint \"**/*.{ts,vue}\" --ignore-path .gitignore",
    "code:lint:fix": "npm run code:lint -- --fix",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "type": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "dependencies": {
    "@faker-js/faker": "^9.2.0",
    "@fontsource-variable/manrope": "^5.1.0",
    "@kendallroth/starter-kit-api": "^0.5.0",
    "@mdi/js": "^7.4.47",
    "@tanstack/vue-query": "^5.59.17",
    "@types/js-yaml": "^4.0.9",
    "@vee-validate/yup": "^4.14.6",
    "@vueuse/core": "^11.2.0",
    "assert": "^2.1.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "i18next": "^23.16.4",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^2.6.2",
    "i18next-vue": "^5.0.0",
    "js-yaml": "^4.1.0",
    "msw": "^2.6.0",
    "npm-run-all2": "^7.0.1",
    "patch-package": "^8.0.0",
    "pinia": "^2.2.6",
    "sass-embedded": "^1.80.6",
    "vee-validate": "^4.14.6",
    "vite-plugin-vuetify": "^2.0.4",
    "vue": "~3.5.12",
    "vue-router": "^4.4.5",
    "vuetify": "^3.7.3",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.4",
    "@tsconfig/node18": "^18.2.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.8.7",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.56.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "type-fest": "^4.26.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.10"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
